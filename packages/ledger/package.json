{
  "name": "@1percentlabs/ledger",
  "version": "0.1.1",
  "description": "Domain-agnostic, append-only event store with first-class provenance and per-entity state machines, on plain PostgreSQL.",
  "license": "MIT",
  "author": "1 Percent Labs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadAlMezaal/ledger.git",
    "directory": "packages/ledger"
  },
  "homepage": "https://github.com/ahmadAlMezaal/ledger/tree/main/packages/ledger#readme",
  "bugs": {
    "url": "https://github.com/ahmadAlMezaal/ledger/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "event-sourcing",
    "event-store",
    "postgres",
    "provenance",
    "audit-log",
    "state-machine",
    "append-only"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.7.1",
    "@types/node": "^22.18.9",
    "@types/pg": "^8.15.6",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
